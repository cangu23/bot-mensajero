# ── Obligatorio ──────────────────────────────────────────────
# Token del bot (Discord Developer Portal → Applications → Bot → Token)
DISCORD_TOKEN=

# ── Opcional ─────────────────────────────────────────────────
# ID del servidor: lo usamos para mostrarte el enlace de invitación en los logs
GUILD_ID=

# Twitch (obligatorio solo si vas a vigilar canales de Twitch)
# 1. Ve a https://dev.twitch.tv/console/apps y crea una app ("Other")
# 2. Copia aquí el Client ID y genera un Client Secret
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ── Ajustes ──────────────────────────────────────────────────
# Cada cuántos segundos se comprueba si hay directos (mínimo 10)
POLL_INTERVAL_SECONDS=60

# Archivo donde se guardan streamers y estado (se crea solo)
DATA_FILE=./data/store.db

# ── Panel web (opcional) ─────────────────────────────────────
# Contraseña del panel de gestión. Si la dejas vacía, el panel NO arranca.
WEB_PANEL_PASSWORD=

# Puerto y dirección donde escucha el panel.
# Para acceder desde fuera (VPS) usa 0.0.0.0; para solo local, 127.0.0.1
WEB_PANEL_PORT=3000
WEB_PANEL_HOST=127.0.0.1

# Dirección pública del panel (la que se abre con el botón de /ms en Discord).
# Ej: http://192.168.1.10:3000 (red local) o https://panel.tudominio.com (VPS)
# Si la dejas vacía, el botón usará http://localhost:3000
WEB_PANEL_URL=